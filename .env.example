# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
# General prefix for commands
COMMAND_PREFIX=!

# Welcome channel ID (leave blank to disable)
WELCOME_CHANNEL_ID=1532057046218969195

# Auto-role ID (role to assign on join, leave blank to disable)
AUTO_ROLE_ID=1532057045568721049

# Moderator role ID (users with this role bypass certain checks)
MOD_ROLE_NAME=・ΛDMIN 〢⚒

# Music settings
MUSIC_VOLUME=50

# SA-MP server settings (used by the samp cog)
# Host can be an IP or hostname; query port is usually 7777
SAMP_SERVER_HOST=
SAMP_SERVER_PORT=7777
# Seconds to wait for a server response before marking it offline
SAMP_QUERY_TIMEOUT=5

# XLRP game database (used by the database cog)
# 127.0.0.1 only works if the bot runs on the same machine/server as the DB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=s33_Xlrp
